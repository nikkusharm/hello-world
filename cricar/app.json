{
  "expo": {
    "name": "CricAR",
    "slug": "cricar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1128"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cricar.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CricAR needs camera access to scan cards and display AR cricket pitch",
        "NSBluetoothAlwaysUsageDescription": "CricAR uses Bluetooth to connect with nearby players",
        "NSBluetoothPeripheralUsageDescription": "CricAR uses Bluetooth to host and join local matches",
        "NSLocalNetworkUsageDescription": "CricAR uses local network to find nearby matches",
        "NFCReaderUsageDescription": "CricAR uses NFC to verify premium legend cards"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1128"
      },
      "package": "com.cricar.app",
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_ADVERTISE",
        "ACCESS_FINE_LOCATION",
        "NFC",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-barcode-scanner",
      [
        "react-native-ble-plx",
        { "isBackgroundEnabled": false, "neverForLocation": true }
      ],
      "react-native-nfc-manager"
    ],
    "scheme": "cricar",
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
